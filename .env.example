# Public Vite configuration. These identifiers are not secrets, but production
# values should still be managed in the hosting environment.

# Existing Google Tag Manager container. GTM loads only after analytics or
# marketing consent.
VITE_GTM_ID=GTM-MGFQ7ZGX

# Numeric Meta Pixel ID, for example: 123456789012345
# Meta Pixel loads only after marketing consent.
VITE_META_PIXEL_ID=
