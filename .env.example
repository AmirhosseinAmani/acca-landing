# ------------------------------------------------------------------
# ACCA EDU — environment variables (Vite). Copy this file to `.env`
# and fill in the values, or set them in your hosting provider.
# Every var is OPTIONAL: leave a value empty and that tag is simply
# not loaded (the site runs exactly as before).
# ------------------------------------------------------------------

# Analytics & Google Ads conversion tracking ------------------------
# See src/constants/analytics.js for how these are used.
#
# Option A — route everything through your existing GTM container
# (then configure the Google Ads conversion tags inside GTM):
VITE_GTM_ID=

# Option B — fire GA4 + Google Ads conversions directly with gtag
# (skip GTM above and fill these instead):
VITE_GA4_ID=
VITE_ADS_CONVERSION_ID=

# Google Ads conversion labels (the part after the slash in
# "AW-123456789/AbC-D_efGh"). Only needed with Option B.
VITE_ADS_LABEL_WHATSAPP=
VITE_ADS_LABEL_LEAD=
VITE_ADS_LABEL_INSTAGRAM=
